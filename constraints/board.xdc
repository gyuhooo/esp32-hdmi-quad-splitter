## Generated by hardware/gen/gen_xdc.py from fpga_pinmap.csv
## Board: FPGA main board (XC7A35T-1FTG256C) + quad HDMI TX carrier (J1/J2). All I/O 3.3 V LVCMOS.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

## 100 MHz oscillator (X1 -> MRCC) and reset button
set_property -dict {PACKAGE_PIN D4 IOSTANDARD LVCMOS33} [get_ports {clk100}]
set_property -dict {PACKAGE_PIN T3 IOSTANDARD LVCMOS33 PULLUP true} [get_ports {rst_n}]
create_clock -period 10.000 -name clk100 [get_ports clk100]

## ADV7513 parallel RGB (carrier J1/J2), I2C, LEDs
set_property -dict {PACKAGE_PIN T4 IOSTANDARD LVCMOS33 SLEW FAST} [get_ports {hdmi_clk[0]}]
set_property -dict {PACKAGE_PIN F3 IOSTANDARD LVCMOS33 SLEW FAST} [get_ports {hdmi_clk[1]}]
set_property -dict {PACKAGE_PIN A10 IOSTANDARD LVCMOS33 SLEW FAST} [get_ports {hdmi_clk[2]}]
